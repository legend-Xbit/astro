---
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import PartCard from '../components/PartCard.astro';
import Pill from '../components/Pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const featured = (await getCollection('parts'))
	.filter((part) => part.data.featured)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const picks = [
	{
		icon: 'shield' as const,
		title: 'أصل معتمد',
		text: 'نأخذ القطع من مصادر المصنع أو وكلائها، لا من رف عشوائي.',
	},
	{
		icon: 'wrench' as const,
		title: 'فحص قبل البيع',
		text: 'كل قطعة تمر على منصة الورشة: قياس، ملاءمة، ثم اعتماد.',
	},
	{
		icon: 'car' as const,
		title: 'توافق المركبة',
		text: 'نطابق رقم الهيكل والسنة قبل أن تغادر القطعة الرف.',
	},
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero title="ورشة تختار لكم أفضل القطع" tagline={SITE_DESCRIPTION} align="start">
					<div class="roles">
						<Pill><Icon icon="shield" size="1.33em" /> أصلي</Pill>
						<Pill><Icon icon="wrench" size="1.33em" /> مفحوص</Pill>
						<Pill><Icon icon="car" size="1.33em" /> متوافق</Pill>
					</div>
				</Hero>
				<div class="hero-panel" aria-hidden="true">
					<div class="ring"></div>
					<div class="bolt"></div>
				</div>
			</header>

			<section class="picks">
				{
					picks.map((pick) => (
						<article class="pick">
							<Icon icon={pick.icon} size="1.8em" gradient />
							<h2>{pick.title}</h2>
							<p>{pick.text}</p>
						</article>
					))
				}
			</section>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>مختارات الرف</h3>
					<p>أربع قطع نعتمدها يومياً في الورشة لأنها تثبت أداءها بعد التركيب، لا على الورق فقط.</p>
				</header>
				<div class="gallery">
					<Grid variant="offset">
						{
							featured.map((part) => (
								<li>
									<PartCard part={part} />
								</li>
							))
						}
					</Grid>
				</div>
				<div class="cta">
					<CallToAction href="/catalog/">
						كل الكتالوج
						<Icon icon="arrow-left" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero-panel {
		position: relative;
		width: min(100%, 22rem);
		aspect-ratio: 5 / 4;
		border-radius: 1.5rem;
		background:
			radial-gradient(
				circle at 50% 50%,
				transparent 34%,
				var(--accent-regular) 36% 44%,
				transparent 46%
			),
			linear-gradient(145deg, var(--gray-100), var(--gray-50));
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	.ring {
		position: absolute;
		inset: 18%;
		border: 10px solid color-mix(in srgb, var(--accent-light) 70%, transparent);
		border-radius: 50%;
	}

	.bolt {
		position: absolute;
		inset: 38%;
		border-radius: 50%;
		background: var(--gradient-accent-orange);
		box-shadow: inset 0 0 0 6px var(--gray-50);
	}

	.picks {
		display: grid;
		gap: 1rem;
	}

	.pick {
		display: grid;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.pick h2 {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.pick p {
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero-panel {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
		}

		.picks {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}

		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section-header {
			grid-area: header;
			justify-self: flex-start;
			text-align: start;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}
</style>
